et="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="new_records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="c47" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1117" y="600"/><mxPoint x="311" y="600"/></Array></mxGeometry></mxCell><mxCell id="c59" value="ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c30" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;Idempotent nodes:&lt;/b&gt; each node only processes papers with no event for its step under the current protocol version, so a re-run resumes after a crash, after &lt;code&gt;queue import&lt;/code&gt;, or after re-calibration.&lt;br&gt;Papers routed to &lt;i&gt;needs_human&lt;/i&gt; wait; the rest of the graph keeps moving. One failing paper logs an &lt;code&gt;error&lt;/code&gt; event and does not stop the run (&lt;code&gt;--workers&lt;/code&gt; threads)." style="whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="625" width="900" height="95" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;--until STAGE&lt;/b&gt; (identify … synthesize)&lt;br&gt;pause after that node, e.g. &lt;code&gt;--until screen_ta&lt;/code&gt; to calibrate first;&lt;br&gt;then &lt;code&gt;write_report()&lt;/code&gt; is still called (unless STAGE = synthesize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="625" width="420" height="90" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Store — WORKDIR/&lt;/b&gt;&lt;br&gt;event log (paper_added, screened, fulltext, extracted, verified, snowball_round, …)&lt;br&gt;texts · pdfs/" style="whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="300" height="100" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;report.md&lt;/b&gt;&lt;br&gt;(write_report)" style="whiteSpace=wrap;html=1;shape=note;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="780" width="170" height="80" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;human_queue.csv&lt;/b&gt;&lt;br&gt;export_queue() at end of every run" style="whiteSpace=wrap;html=1;shape=note;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="780" width="190" height="80" as="geometry"/></mxCell><mxCell id="c65" value="&lt;code&gt;slr run&lt;/code&gt; prints: &lt;i&gt;protocol &amp;lt;version&amp;gt;: report at WORKDIR/report.md; N items in WORKDIR/human_queue.csv&lt;/i&gt;" style="whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="785" width="590" height="70" as="geometry"/></mxCell><mxCell id="c66" value="append events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;endArrow=open;" edge="1" parent="1" source="c44" target="c62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="639" y="745"/><mxPoint x="210" y="745"/></Array></mxGeometry></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c48" target="c63"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1339" y="760"/><mxPoint x="555" y="760"/></Array></mxGeometry></mxCell><mxCell id="c68" value="export_queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c62" target="c64"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="890"/><mxPoint x="795" y="890"/></Array></mxGeometry></mxCell><mxCell id="c69" value="3 · Human-in-the-loop &amp; threshold calibration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="92