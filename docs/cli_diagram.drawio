<mxfile host="app.diagrams.net"><diagram id="cli" name="slr CLI pipeline"><mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;convtts-slr — &lt;code&gt;slr&lt;/code&gt; CLI pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;From &lt;code&gt;src/convtts_slr/cli.py&lt;/code&gt; (Typer app) and &lt;code&gt;stages.py&lt;/code&gt; (&lt;code&gt;build_graph&lt;/code&gt;). Each command loads the protocol with &lt;code&gt;load_protocol(--protocol, --thresholds)&lt;/code&gt; and opens &lt;code&gt;Store(WORKDIR, protocol.version)&lt;/code&gt;.&lt;/span&gt;" style="whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1520" height="50" as="geometry"/></mxCell><mxCell id="c2" value="1 · slr run WORKDIR — build the Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1520" height="290" as="geometry"/></mxCell><mxCell id="c3" value="WORKDIR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="55" y="120" width="154" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Store(workdir, version)&lt;br&gt;&lt;i&gt;append-only event log&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="154" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="--protocol P&lt;br&gt;--thresholds F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="221" y="120" width="154" height="56" as="geometry"/></mxCell><mxCell id="c7" value="load_protocol()&lt;br&gt;+ apply_thresholds()&lt;br&gt;→ Protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="221" y="210" width="154" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="--sources&lt;br&gt;openalex,s2,arxiv[,acl]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="387" y="120" width="154" height="56" as="geometry"/></mxCell><mxCell id="c10" value="OpenAlex · SemanticScholar&lt;br&gt;arXiv · ACL Anthology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="387" y="210" width="154" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="--local FILE&lt;br&gt;(repeatable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="553" y="120" width="154" height="56" as="geometry"/></mxCell><mxCell id="c13" value="LocalSource(file)&lt;br&gt;&lt;i&gt;e.g. IEEE Xplore CSV&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="553" y="210" width="154" height="64" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="--seeds&lt;br&gt;data/seeds.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="719" y="120" width="154" height="56" as="geometry"/></mxCell><mxCell id="c16" value="LocalSource(&amp;quot;seeds&amp;quot;)&lt;br&gt;→ seed papers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="210" width="154" height="64" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="--snowball / --no-snowball" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="885" y="120" width="154" height="56" as="geometry"/></mxCell><mxCell id="c19" value="citation sources&lt;br&gt;[OpenAlex, S2] or []" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="210" width="154" height="64" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="--backend jev|llm&lt;br&gt;--model M" style="rounded=1;whiteSpace=