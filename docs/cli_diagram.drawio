mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="2 · build_graph().run(&quot;identify&quot;, ctx, stop_after=--until)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1520" height="330" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;identify&lt;/b&gt;&lt;hr size=1&gt;integrate seeds; search each source;&lt;br&gt;dedup.integrate → paper_added / updated;&lt;br&gt;search_done (failed source retried)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="158" height="110" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;screen_ta&lt;/b&gt;&lt;hr size=1&gt;title/abstract screening via Decider;&lt;br&gt;IC5 year rule is deterministic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="232" y="450" width="158" height="110" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;fetch_fulltext&lt;/b&gt;&lt;hr size=1&gt;download PDF → text for TA includes&lt;br&gt;&amp;amp; baselines; drop PDFs in pdfs/ to retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="404" y="450" width="158" height="110" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;screen_ft&lt;/b&gt;&lt;